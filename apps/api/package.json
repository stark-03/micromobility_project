{
  "name": "@mm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "build": "tsc -b",
    "db:create": "node --env-file=../../.env scripts/db.ts create",
    "db:migrate": "node --env-file=../../.env scripts/db.ts migrate",
    "db:migrate:undo": "node --env-file=../../.env scripts/db.ts undo",
    "db:make": "node scripts/db.ts make",
    "db:seed": "node --env-file=../../.env scripts/db.ts seed"
  },
  "dependencies": {
    "@mm/shared-types": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "node-cache": "^5.1.2",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
