NODE_ENV=development
API_PORT=4000
WEB_PORT=5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=micromobility
DB_NAME_TEST=micromobility_test
DB_USER=root
DB_PASSWORD=

# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_me_with_a_different_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CACHE_DRIVER=memory
QUEUE_DRIVER=inline
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_SECRET=dev_only_secret
CORS_ORIGIN=http://localhost:5173

# M14 payments. 'mock' approves every charge and stores only a fake provider
# reference; no card data ever touches this system.
PAYMENT_GATEWAY=mock
